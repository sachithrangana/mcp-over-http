{
  "mcpServers": {
    "crud-products": {
      "command": "uv",
      "args": [
        "run",
        "--no-project",
        "--python", "3.12",
        "--with", "mcp>=2.2.0",
        "--with", "httpx>=0.28",
        "python",
        "${CLAUDE_PLUGIN_ROOT}/server.py"
      ],
      "env": {
        "CRUD_API_BASE_URL": "http://localhost:8090",
        "CRUD_PLUGIN_CLIENT_ID": "crud-plugin",
        "CRUD_SCOPE": "products.read products.write"
      }
    }
  }
}
